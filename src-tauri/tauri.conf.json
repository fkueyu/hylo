{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hylo",
  "version": "0.1.22",
  "identifier": "ink.ainx.hylo.editor.v2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hylo",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "maximized": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: asset://localhost http://asset.localhost https:; font-src 'self' data:; media-src 'self' asset: asset://localhost http://asset.localhost blob: data:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self' about: blob: data:; object-src 'none'; base-uri asset: asset://localhost http://asset.localhost; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "dangerousDisableAssetCspModification": [
        "script-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "html",
          "htm",
          "xhtml"
        ],
        "contentTypes": [
          "public.html"
        ],
        "name": "HTML Document",
        "description": "HTML Document",
        "role": "Editor",
        "rank": "Default",
        "mimeType": "text/html"
      }
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "12.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxQkYzRjYyMUIwRUVEM0MKUldRODdRNGJZaisva2VqV2QzYit2OEJVc2VkMzB2NUVEa0tHZUxTTWltOExaN2RsOTVsR0x4S1AK",
      "endpoints": [
        "https://ainx.ink/apps/hylo/updater.json"
      ]
    }
  }
}
